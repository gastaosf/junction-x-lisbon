# Copy to .env (gitignored). A blank value means "use the default".

# Required for any real run.
OPENAI_API_KEY=

# Optional backends. Without them streetview_lookup has no imagery source and
# search_places uses Nominatim and Photon only.
GOOGLE_MAPS_API_KEY=
MAPILLARY_TOKEN=

TEAM_NAME=

# Organiser-question defaults (SPEC section 13). Change only when the organisers answer.
ALLOW_WEB=true            # Q1: false switches every external tool off
PENALTY_SCOPE=whole_list  # Q2: whole_list | subsequent
ALLOW_DUPLICATES=true     # Q3: false gives the top 10 distinct points
EMBED_IMAGES=false        # Q4: true inlines base64 images in each export
MCQ_ALLOWED=true          # Q7: false starts every panorama with questions switched off
MAX_MCQ=3
GLOBAL_WATCHDOG_S=3000    # Q10: seconds after which every panorama is finalised

# Answer construction and autonomy.
HEDGE=false
NO_HUMAN=false

# Paths and model.
RUNS_DIR=runs
CACHE_DIR=.cache
ASTROLABIO_MODEL=gpt-6.1-sol        # gpt-6-astra is the stronger model at five times the price
ASTROLABIO_IMAGE_DETAIL=original    # low | high | original | auto, sent with every image
API_READ_TIMEOUT_S=60     # a stream silent for this long is dropped and the turn re-issued
